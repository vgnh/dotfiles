# Profile for laptop screen only, with no external monitors connected
profile laptop {
    # Lenovo screen
    output "eDP-1" {
        position 0,0
        transform normal
        mode 1920x1200@60.003Hz
        adaptive_sync on
        scale 1.0
        enable
    }
}

# Profile for home setup
profile home_dock {
    # Lenovo screen
    output "eDP-1" {
        position 0,0
        transform normal
        mode 1920x1200@60.003Hz
        adaptive_sync on
        scale 1.0
        disable
    }
    # BenQ monitor "HDMI-A-1"
    output "BNQ BenQ GW2790QT V8P00319019" {
        position 1920,0
        transform normal
        mode 2560x1440@74.971Hz
        adaptive_sync off
        scale 1.0
        enable
    }
}
