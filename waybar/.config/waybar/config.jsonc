// -*- mode: jsonc -*-
{
    // Load the system-wide default configuration first
    "include": [
        "/etc/xdg/waybar/config.jsonc"
    ],
    // Anything below this line will override the default settings
    "height": 32, // Waybar height (to be removed for auto height)
    "clock": {
        // "timezone": "America/New_York",
        // "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "tooltip-format": "<big><tt>{calendar}</tt>\n<b>{tz_list}</b></big>",
        "format": "{:%a %d %b %H:%M}",
        "format-alt": "{:%H:%M}",
        "timezone-tooltip-format": "{:%H:%M %Z (%z)}",
        "timezones": [
            "",
            "UTC",
            "Europe/Paris"
        ],
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "shift_up",
            "on-click-middle": "shift_down",
            "on-scroll-up": "shift_reset" // This is inverted scrolling
        }
    }
}
